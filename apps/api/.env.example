# Base local. Reproduzivel: `pnpm db:push && pnpm sync` reconstroi tudo a
# partir da API do Banco Central.
DATABASE_URL="file:./dev.db"

PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# Para rodar este painel junto com o cod-dashboard, que usa as mesmas portas:
# mude PORT e CORS_ORIGIN aqui, e exporte API_PORT e WEB_PORT com os mesmos
# valores antes do `pnpm dev` -- o proxy do Vite le os dois.
#   API_PORT=4001 WEB_PORT=5174 pnpm dev

# Modelo local. Usado apenas para narrar e conversar -- nunca para calcular.
# Sem ele o painel funciona inteiro; so o resumo e o chat ficam indisponiveis.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b

# Semente da amostragem. Temperatura baixa nao e temperatura zero: sem ela, a
# mesma pergunta com o mesmo historico da respostas diferentes entre
# execucoes -- e um defeito que aparece uma vez a cada tantas nao tem como
# ser investigado. Trocar o numero nao quebra nada; so muda quais respostas
# o assistente produz.
OLLAMA_SEED=20260904

# API de series temporais do Banco Central (SGS). Publica, sem autenticacao.
BCB_API_BASE_URL=https://api.bcb.gov.br/dados/serie
BCB_REQUEST_TIMEOUT_MS=15000

# Sincronizacao com a fonte externa.
SYNC_ON_BOOT=true
SYNC_INTERVAL_MINUTES=60
# Idade a partir da qual uma serie e revalidada sob demanda, por frequencia.
# Serie mensal nao ganha nada sendo consultada de hora em hora.
SYNC_STALE_MINUTES_DIARIA=240
SYNC_STALE_MINUTES_MENSAL=720
