{
  "name": "painel-macroeconomico",
  "version": "0.1.0",
  "private": true,
  "description": "Painel de indicadores macroeconomicos do Banco Central do Brasil, com resumo e assistente em modelo local ancorados nos dados",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm --filter @bcb/api dev",
    "dev:web": "pnpm --filter @bcb/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @bcb/api db:generate",
    "db:push": "pnpm --filter @bcb/api db:push",
    "db:studio": "pnpm --filter @bcb/api db:studio",
    "sync": "pnpm --filter @bcb/api sync"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
